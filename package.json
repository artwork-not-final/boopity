{
  "name": "boopity",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:self-hosted": "vite --config vite.self-hosted.config.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env.self-hosted server/index.ts",
    "build:self-hosted": "tsc -b && vite build --config vite.self-hosted.config.ts && node scripts/build-notices.mjs browser && esbuild server/index.ts server/manage.ts server/healthcheck.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "manage": "node --env-file-if-exists=.env.self-hosted dist/server/manage.mjs",
    "start": "node --env-file-if-exists=.env.self-hosted dist/server/index.mjs",
    "verify:self-hosted": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:self-hosted && npm run test:setup-management",
    "dev": "npm run dev:self-hosted",
    "build": "npm run build:self-hosted",
    "preview": "npm start",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:setup-browser": "tsx tests/setup-browser-local.ts",
    "test:portal-browser": "tsx tests/portal-browser-local.ts",
    "test:payment-browser": "tsx tests/payment-browser-local.ts",
    "test:lists-browser": "tsx tests/large-list-local.ts --browser",
    "test:lists-load": "tsx tests/large-list-local.ts",
    "test:setup-management": "node tests/setup-management-local.mjs && node tests/startup-local.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:source": "node scripts/release-source.mjs",
    "hosting:render": "node scripts/render-blueprint.mjs",
    "verify": "npm run verify:self-hosted"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.42.0",
    "nodemailer": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.5",
    "oxlint": "1.83.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
